diff --git a/crates/ui-egui/src/touch.rs b/crates/ui-egui/src/touch.rs
new file mode 100644
index 0000000..9fd99d8
--- /dev/null
+++ b/crates/ui-egui/src/touch.rs
@@ -0,0 +1,57 @@
+//! EffectDroid (mobile): touch gestures for phone layouts, mirroring PhotoDroid's
+//! `mobile.rs` helpers. A phone's taps and held presses stand in for a mouse: list rows
+//! sense clicks alone so a swipe scrolls the list, and a press held down does a
+//! double-click's job (egui's second tap rarely arrives inside its double-click window).
+//! Wide windows keep the desktop behaviour byte for byte.
+
+use egui::{Context, Response, Sense};
+
+/// The per-frame phone flag, set by `EffectcraftApp::update` (the shorter side under
+/// 600 pt, in either orientation).
+fn phone_key() -> egui::Id {
+    egui::Id::new("effectdroid-phone")
+}
+
+/// Sticky knowledge that this app has seen a touch event; a mouse-only session never
+/// sets it, so desktop rows keep their drag.
+fn touch_key() -> egui::Id {
+    egui::Id::new("effectdroid-touch-seen")
+}
+
+/// Called once per frame with the phone-layout flag. Records any touch event alongside
+/// it so the gestures below can tell a finger from a mouse.
+pub fn set_phone(ctx: &Context, on: bool) {
+    let touch = ctx.input(|i| i.events.iter().any(|e| matches!(e, egui::Event::Touch { .. })));
+    ctx.data_mut(|d| {
+        d.insert_temp(phone_key(), on);
+        if touch {
+            d.insert_temp(touch_key(), true);
+        }
+    });
+}
+
+/// Is this frame on the phone layout?
+pub fn phone(ctx: &Context) -> bool {
+    ctx.data(|d| d.get_temp::<bool>(phone_key())).unwrap_or(false)
+}
+
+/// A finger on a phone's screen: rows then take clicks alone ([`row_sense`]), because a
+/// finger's drag would otherwise take the swipe that should scroll the list.
+pub fn touch_screen(ctx: &Context) -> bool {
+    phone(ctx) && ctx.data(|d| d.get_temp::<bool>(touch_key())).unwrap_or(false)
+}
+
+/// The sense of a list row: a drag where a mouse has one (it reorders or applies the
+/// row), a click alone on a touch screen so a swipe scrolls the list.
+pub fn row_sense(ctx: &Context) -> Sense {
+    if touch_screen(ctx) { Sense::click() } else { Sense::click_and_drag() }
+}
+
+/// Does this response ask for its second-tap action? With a mouse that is a double-click.
+/// On a touch screen the second tap often arrives too late for egui's window (0.3 s), so
+/// a press held down does the same job instead — only on the phone layout, and only for
+/// widgets without a context menu: a long press there opens the menu already, because
+/// egui's `secondary_clicked` includes `long_touched`.
+pub fn held_or_double(ctx: &Context, resp: &Response) -> bool {
+    resp.double_clicked() || (resp.long_touched() && phone(ctx))
+}
